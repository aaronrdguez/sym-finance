generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             Int             @id @default(autoincrement())
  uuid           String          @unique
  username       String
  email          String          @unique
  passwordHash   String
  avatarUrl      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  refreshToken   String?
  preferences    Json?
  accounts       Account[]
  chatMessages   ChatMessage[]
  operations     Operation[]
  portfolioItems PortfolioItem[]
  reserves       Reserve[]
  subscriptions  Subscription[]
  installments   Installment[]
  connections    Connection[]
}

model Account {
  id             Int         @id @default(autoincrement())
  uuid           String      @unique @db.Uuid
  userId         Int
  name           String
  icon           String
  balance        Decimal     @default(0) @db.Decimal(12, 2)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  color          String
  type           String
  currency       String
  connectionUuid String?
  user           User        @relation(fields: [userId], references: [id])
  operations     Operation[]
}

model Operation {
  id          Int      @id @default(autoincrement())
  uuid        String   @unique @db.Uuid
  userId      Int
  accountId   Int
  category    String
  amount      Decimal  @db.Decimal(12, 2)
  description String?
  currency    String
  type        String
  date        DateTime @default(now())
  externalId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  account     Account  @relation(fields: [accountId], references: [id])
  user        User     @relation(fields: [userId], references: [id])
}

model Reserve {
  id            Int       @id @default(autoincrement())
  uuid          String    @unique @db.Uuid
  userId        Int
  name          String
  targetAmount  Decimal   @db.Decimal(12, 2)
  currentAmount Decimal   @default(0) @db.Decimal(12, 2)
  category      String
  currency      String
  deadline      DateTime?
  completed     Boolean   @default(false)
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id])
}

model PortfolioItem {
  id            Int       @id @default(autoincrement())
  uuid          String    @unique @db.Uuid
  userId        Int
  type          AssetType
  symbol        String
  name          String
  quantity      Decimal   @db.Decimal(18, 8)
  purchasePrice Decimal   @db.Decimal(12, 2)
  currentPrice  Decimal   @db.Decimal(12, 2)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id])
}

model Subscription {
  id              Int       @id @default(autoincrement())
  uuid            String    @unique @db.Uuid
  userId          Int
  amount          Decimal   @db.Decimal(12, 2)
  currency        String
  description     String?
  reason          String
  frequency       Frequency
  nextPaymentDate DateTime
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id])
}

enum Frequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  BIMONTHLY
  QUARTERLY
  SEMIANNUAL
  YEARLY
}

model Installment {
  id                Int       @id @default(autoincrement())
  uuid              String    @unique @db.Uuid
  userId            Int
  description       String
  totalAmount       Decimal   @db.Decimal(12, 2)
  totalPaid         Decimal   @default(0) @db.Decimal(12, 2)
  installmentCount  Int
  paidInstallments  Int       @default(0)
  startDate         DateTime
  frequency         Frequency
  category          String
  currency          String
  completed         Boolean   @default(false)
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id])
}

model Connection {
  id         Int        @id @default(autoincrement())
  uuid       String     @unique @db.Uuid
  userId     Int
  service    String
  label      String?
  credentials String
  enabled    Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  user       User       @relation(fields: [userId], references: [id])
}

model ChatMessage {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique @db.Uuid
  userId    Int
  role      String
  content   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

enum AssetType {
  BOND
  STOCK
  TREASURY_BILL
  CRYPTO
}
